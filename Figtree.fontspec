\defaultfontfeatures[Figtree]
{
    Path=./Figtree/static/,
    Extension = .ttf,
    UprightFont=*-Regular,
    BoldFont=*-Bold,
    BoldItalicFont=*-BoldItalic,
    ItalicFont=*-Italic,
    FontFace={l}{n}{*-Light},
    FontFace={l}{it}{*-LightItalic},
    FontFace={mb}{n}{*-Medium},
    FontFace={mb}{it}{*-MediumItalic},
    FontFace={sb}{n}{*-SemiBold},
    FontFace={sb}{it}{*-SemiBoldItalic},
    FontFace={ub}{n}{*-Black},
    FontFace={ub}{it}{*-BlackItalic},
    FontFace={eb}{n}{Font=*-ExtraBold},
    FontFace={eb}{it}{Font=*-ExtraBoldItalic}
% <any other desired options>
}

